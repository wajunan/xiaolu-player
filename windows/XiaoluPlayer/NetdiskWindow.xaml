<Window x:Class="XiaoluPlayer.NetdiskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="百度网盘 - 小鹿播放增强器" Width="640" Height="700"
        MinWidth="480" MinHeight="500"
        Background="{StaticResource PageBg}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="‹ 返回" Click="Back_Click" Background="Transparent"
                    BorderThickness="0" Foreground="{StaticResource BrandDeepBrush}"
                    FontSize="14" Cursor="Hand" Padding="4,2"/>
            <TextBlock x:Name="PathText" Text="我的网盘" FontSize="18" FontWeight="Bold"
                       Margin="10,0,0,0" Foreground="{StaticResource BrandDeepBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
                <Button Content="当前目录" Click="CurrentDir_Click" Background="Transparent"
                        BorderThickness="0" FontSize="13" Cursor="Hand" Padding="6,2"
                        Foreground="{StaticResource BrandDeepBrush}"/>
                <Button Content="全部视频" Click="AllVideos_Click" Background="Transparent"
                        BorderThickness="0" FontSize="13" Cursor="Hand" Padding="6,2"
                        Foreground="{StaticResource BrandDeepBrush}"/>
                <Button Content="🔄" Click="Refresh_Click" Background="Transparent"
                        BorderThickness="0" FontSize="15" Cursor="Hand" Padding="6,2"
                        ToolTip="刷新"/>
                <Button Content="退出登录" Click="Logout_Click" Background="Transparent"
                        BorderThickness="0" FontSize="13" Cursor="Hand" Padding="6,2"
                        Foreground="{StaticResource InkSoftBrush}"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <StackPanel x:Name="LoginPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Width="440" Visibility="Collapsed">
                <Border Style="{StaticResource CardBorder}" CornerRadius="28"
                        Width="96" Height="96" HorizontalAlignment="Center">
                    <TextBlock Text="☁" FontSize="50" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{StaticResource BrandBrush}"/>
                </Border>
                <TextBlock Text="登录百度网盘后，可在线播放你自己有权限的视频"
                           FontSize="13" Foreground="{StaticResource InkSoftBrush}"
                           TextAlignment="Center" Margin="0,16,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="点击下方按钮，在应用内打开百度官方登录页完成登录（支持扫码等百度官方方式）。账号密码只经过百度官方页面，本应用只保存登录后的会话。"
                           FontSize="12" Foreground="{StaticResource InkSoftBrush}"
                           TextAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <Button Content="应用内登录" Width="220" HorizontalAlignment="Center" Margin="0,14,0,0"
                        Style="{StaticResource PrimaryButton}" Click="InAppLogin_Click"/>
                <Expander Header="手动粘贴 Cookie（备用方式）" Margin="0,16,0,0" FontSize="12"
                          Foreground="{StaticResource InkSoftBrush}">
                    <StackPanel>
                        <TextBlock Text="备用方式：在系统浏览器登录 pan.baidu.com，按 F12 打开开发者工具，从请求头复制 Cookie 粘贴到下面："
                                   FontSize="12" Foreground="{StaticResource InkSoftBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBox x:Name="CookieBox" Height="90" Margin="0,8,0,0" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                        <Button Content="保存并登录" Width="140" HorizontalAlignment="Center" Margin="0,12,0,0"
                                Style="{StaticResource PrimaryButton}" Click="Login_Click"/>
                    </StackPanel>
                </Expander>
            </StackPanel>

            <Grid x:Name="BrowserPanel">
                <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="File_Selected">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0,0,0,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" CornerRadius="16" Padding="12">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource GhostCard}" Width="44" Height="44">
                                        <TextBlock Text="{Binding Icon}" FontSize="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center"
                                                Width="420">
                                        <TextBlock Text="{Binding Name}" FontSize="14"
                                                   Foreground="{StaticResource InkBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Sub}" FontSize="12"
                                                   Foreground="{StaticResource InkSoftBrush}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Badge}" FontSize="18"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource BrandBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="StatusText" FontSize="12" Margin="0,10,0,0"
                   Foreground="{StaticResource InkSoftBrush}"/>
    </Grid>
</Window>
