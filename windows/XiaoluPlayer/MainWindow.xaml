<Window x:Class="XiaoluPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小鹿播放增强器" Width="500" Height="760"
        MinWidth="440" MinHeight="600"
        Background="{StaticResource PageBg}"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,24,20,24">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource BrandDeep}" Offset="0"/>
                            <GradientStop Color="{StaticResource BrandBright}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="▶" Foreground="White" FontSize="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="小鹿播放增强器" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource BrandDeepBrush}"/>
                    <TextBlock Text="只播放你已合法获得访问权限的视频" FontSize="12"
                               Foreground="{StaticResource InkSoftBrush}"/>
                </StackPanel>
            </StackPanel>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}"
                        Height="116" Cursor="Hand" MouseLeftButtonUp="Local_Click">
                    <StackPanel Margin="16">
                        <Border Style="{StaticResource GhostCard}" Width="42" Height="42"
                                HorizontalAlignment="Left">
                            <TextBlock Text="📁" FontSize="20" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="本地视频" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" Margin="0,10,0,0"/>
                        <TextBlock Text="选择文件" FontSize="12"
                                   Foreground="{StaticResource InkSoftBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorder}"
                        Height="116" Cursor="Hand" MouseLeftButtonUp="Url_Click">
                    <StackPanel Margin="16">
                        <Border Style="{StaticResource GhostCard}" Width="42" Height="42"
                                HorizontalAlignment="Left">
                            <TextBlock Text="🔗" FontSize="20" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="打开视频" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" Margin="0,10,0,0"/>
                        <TextBlock Text="URL / 文件" FontSize="12"
                                   Foreground="{StaticResource InkSoftBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="0" Height="116" Cursor="Hand"
                        MouseLeftButtonUp="Netdisk_Click" CornerRadius="20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource BrandDeep}" Offset="0"/>
                            <GradientStop Color="{StaticResource Brand}" Offset="0.55"/>
                            <GradientStop Color="{StaticResource BrandBright}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.25" Color="#3060C0"/>
                    </Border.Effect>
                    <StackPanel Margin="16">
                        <Border Width="42" Height="42" CornerRadius="13" HorizontalAlignment="Left"
                                Background="#38FFFFFF">
                            <TextBlock Text="☁" FontSize="20" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="百度网盘" FontSize="15" FontWeight="SemiBold"
                                   Foreground="White" Margin="0,10,0,0"/>
                        <TextBlock Text="官方登录 / 在线播放" FontSize="12" Foreground="#D9E7FF"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorder}"
                        Height="116" Cursor="Hand" MouseLeftButtonUp="Settings_Click">
                    <StackPanel Margin="16">
                        <Border Style="{StaticResource GhostCard}" Width="42" Height="42"
                                HorizontalAlignment="Left">
                            <TextBlock Text="⚙" FontSize="20" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="设置" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" Margin="0,10,0,0"/>
                        <TextBlock Text="倍速 / 恢复" FontSize="12"
                                   Foreground="{StaticResource InkSoftBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0" VerticalAlignment="Center">
                <TextBlock Text="🕘" FontSize="16" Foreground="{StaticResource BrandBrush}"/>
                <TextBlock Text="最近播放" FontSize="16" FontWeight="Bold" Margin="8,0,0,0"
                           Foreground="{StaticResource InkBrush}"/>
                <TextBlock x:Name="StatusText" FontSize="12" Margin="12,0,0,0"
                           Foreground="{StaticResource InkSoftBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <ListBox x:Name="RecordsList" Margin="0,10,0,0" Background="Transparent"
                     BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="Records_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0,0,0,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" CornerRadius="16" Padding="14">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource GhostCard}" Width="46" Height="46">
                                    <TextBlock Text="🎬" FontSize="20" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="14,0,8,0" VerticalAlignment="Center" Width="300">
                                    <TextBlock Text="{Binding Title}" FontSize="14"
                                               Foreground="{StaticResource InkBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <ProgressBar Value="{Binding Frac}" Maximum="1" Height="4"
                                                 Margin="0,7,0,0" Foreground="{StaticResource BrandBrush}"
                                                 Background="#E7EFF9" BorderThickness="0"/>
                                    <TextBlock Text="{Binding Sub}" FontSize="12" Margin="0,6,0,0"
                                               Foreground="{StaticResource InkSoftBrush}"/>
                                </StackPanel>
                                <Border Width="34" Height="34" CornerRadius="17"
                                        VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{StaticResource Brand}" Offset="0"/>
                                            <GradientStop Color="{StaticResource BrandBright}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="▶" Foreground="White" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </ScrollViewer>
</Window>
