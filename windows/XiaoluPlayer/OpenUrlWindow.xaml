<Window x:Class="XiaoluPlayer.OpenUrlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="打开视频" Width="520" Height="400"
        Background="{StaticResource PageBg}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="视频地址（mp4 / m3u8 / mpd …）" FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource InkBrush}"/>
        <TextBox x:Name="UrlBox" Margin="0,8,0,0" Height="60" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
        <TextBlock Text="标题（可选）" FontSize="13" Margin="0,12,0,0"
                   Foreground="{StaticResource InkSoftBrush}"/>
        <TextBox x:Name="TitleBox" Margin="0,6,0,0"/>
        <TextBlock Text="自定义请求头（可选，部分直链需要 Referer / Cookie）" FontSize="13"
                   Margin="0,12,0,0" Foreground="{StaticResource InkSoftBrush}"/>
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Referer" VerticalAlignment="Center"
                       Foreground="{StaticResource InkSoftBrush}"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="RefererBox"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="User-Agent" VerticalAlignment="Center"
                       Foreground="{StaticResource InkSoftBrush}"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="UaBox"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Cookie" VerticalAlignment="Center"
                       Foreground="{StaticResource InkSoftBrush}"/>
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="CookieBox"/>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Width="90" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="开始播放" Width="110" Style="{StaticResource PrimaryButton}"
                    Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
