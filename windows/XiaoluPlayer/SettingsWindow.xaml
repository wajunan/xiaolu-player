<Window x:Class="XiaoluPlayer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 - 小鹿播放增强器" Width="440" Height="360"
        Background="{StaticResource PageBg}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="28">
        <TextBlock Text="默认倍速" FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource InkBrush}"/>
        <ComboBox x:Name="SpeedBox" Margin="0,8,0,0" Width="200" HorizontalAlignment="Left">
            <ComboBoxItem Content="0.5x"/>
            <ComboBoxItem Content="0.75x"/>
            <ComboBoxItem Content="1.0x"/>
            <ComboBoxItem Content="1.25x"/>
            <ComboBoxItem Content="1.5x"/>
            <ComboBoxItem Content="2.0x"/>
            <ComboBoxItem Content="3.0x"/>
        </ComboBox>
        <CheckBox x:Name="RememberBox" Content="记住上次倍速" FontSize="14" Margin="0,16,0,0"
                  Foreground="{StaticResource InkBrush}"/>
        <CheckBox x:Name="ResumeBox" Content="自动恢复上次播放位置" FontSize="14" Margin="0,12,0,0"
                  Foreground="{StaticResource InkBrush}"/>
        <Button Content="清空播放记录" Width="140" Margin="0,20,0,0" HorizontalAlignment="Left"
                Click="Clear_Click"/>
        <TextBlock Text="小鹿播放增强器 v1.0&#x0a;仅用于播放你已合法获得访问权限的视频。"
                   FontSize="12" Margin="0,20,0,0" Foreground="{StaticResource InkSoftBrush}"
                   TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="关闭" Width="90" Margin="0,0,10,0" Click="Close_Click"/>
            <Button Content="保存" Width="90" Style="{StaticResource PrimaryButton}"
                    Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
