<Window x:Class="XiaoluPlayer.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="登录百度网盘 - 小鹿播放增强器" Width="900" Height="700"
        MinWidth="640" MinHeight="500"
        Background="{StaticResource PageBg}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,12,16,8">
            <TextBlock Text="在百度官方页面完成登录" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource BrandDeepBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="正在加载…" FontSize="12"
                       Foreground="{StaticResource InkSoftBrush}" Margin="12,0,0,0"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Margin="16,0,16,0" Background="White"
                CornerRadius="4" BorderBrush="#C9D6EA" BorderThickness="1">
            <wv2:WebView2 x:Name="Web"/>
        </Border>
        <StackPanel Grid.Row="2" Margin="16,10,16,14">
            <TextBlock Text="账号密码仅由百度官方页面处理，本应用只读取登录后的 Cookie 会话，用于播放你自己有权限的视频。会话仅保存在本机，不会上传到任何地方。"
                       FontSize="12" Foreground="{StaticResource InkSoftBrush}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="取消" Width="110" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button x:Name="DoneButton" Content="已登录 · 进入网盘" Width="170"
                        Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Done_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
