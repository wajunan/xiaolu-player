<Window x:Class="XiaoluPlayer.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="小鹿播放增强器" Width="1100" Height="680"
        MinWidth="640" MinHeight="420"
        Background="Black" WindowStartupLocation="CenterScreen">
    <Grid>
        <vlc:VideoView x:Name="VideoView" Background="Black">
            <vlc:VideoView.Content>
                <Grid x:Name="Overlay" MouseMove="Overlay_MouseMove" Focusable="True"
                      FocusManager.FocusedElement="{Binding ElementName=Overlay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" x:Name="TopBar" Padding="12,10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#B3000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <DockPanel>
                            <Button Content="‹ 返回" Click="Back_Click" DockPanel.Dock="Left"
                                    Foreground="White" Background="Transparent" BorderThickness="0"
                                    FontSize="14" Cursor="Hand" Padding="6,2"/>
                            <TextBlock x:Name="TitleText" Foreground="White" FontSize="14"
                                       Margin="10,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <ComboBox x:Name="SpeedBox" Width="76" Margin="0,0,6,0"
                                          SelectionChanged="Speed_Changed" ToolTip="倍速"
                                          Foreground="White"/>
                                <ComboBox x:Name="QualityBox" Width="110" Margin="0,0,6,0"
                                          SelectionChanged="Quality_Changed" ToolTip="画质"
                                          Visibility="Collapsed" Foreground="White"/>
                                <ComboBox x:Name="AudioBox" Width="76" Margin="0,0,6,0"
                                          SelectionChanged="Audio_Changed" ToolTip="音轨"
                                          Foreground="White"/>
                                <ComboBox x:Name="SubtitleBox" Width="86" Margin="0,0,6,0"
                                          SelectionChanged="Subtitle_Changed" ToolTip="字幕"
                                          Foreground="White"/>
                                <ComboBox x:Name="AspectBox" Width="86" Margin="0,0,6,0"
                                          SelectionChanged="Aspect_Changed" ToolTip="画面比例"
                                          Foreground="White"/>
                                <Button Content="字幕文件…" Click="SubFile_Click"
                                        Foreground="White" Background="Transparent"
                                        BorderThickness="0" FontSize="13" Cursor="Hand"
                                        Padding="6,2"/>
                                <CheckBox x:Name="TopmostBox" Content="置顶" Foreground="White"
                                          Margin="8,0,0,0" VerticalAlignment="Center"
                                          Checked="Topmost_Changed" Unchecked="Topmost_Changed"/>
                                <Button Content="⛶" Click="Fullscreen_Click" Foreground="White"
                                        Background="Transparent" BorderThickness="0" FontSize="16"
                                        Cursor="Hand" Padding="6,2" ToolTip="全屏 (F)"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Background="Transparent"
                            MouseLeftButtonDown="Video_Click">
                        <TextBlock x:Name="LoadingText" Text="加载中…" Foreground="#E6FFFFFF"
                                   FontSize="16" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Visibility="Collapsed"
                                   IsHitTestVisible="False"/>
                    </Border>
                    <Border Grid.Row="2" x:Name="BottomBar" Padding="12,8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#B3000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PlayBtn" Content="⏸" Click="PlayPause_Click"
                                        Foreground="White" Background="Transparent"
                                        BorderThickness="0" FontSize="22" Width="44"
                                        Cursor="Hand"/>
                                <Button Content="⏪10s" Click="Back10_Click" Foreground="White"
                                        Background="Transparent" BorderThickness="0" FontSize="13"
                                        Cursor="Hand" Padding="6,2"/>
                                <Button Content="10s⏩" Click="Fwd10_Click" Foreground="White"
                                        Background="Transparent" BorderThickness="0" FontSize="13"
                                        Cursor="Hand" Padding="6,2"/>
                                <TextBlock x:Name="TimeText" Text="0:00 / 0:00" Foreground="White"
                                           FontSize="12" VerticalAlignment="Center" Margin="10,0"/>
                                <TextBlock Text="🔊" Foreground="White" FontSize="13"
                                           VerticalAlignment="Center"/>
                                <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="100"
                                        Value="100" Margin="6,0,0,0" VerticalAlignment="Center"
                                        ValueChanged="Volume_Changed"/>
                            </StackPanel>
                            <Slider x:Name="SeekSlider" Minimum="0" Maximum="1000" Value="0"
                                    Margin="0,6,0,2" PreviewMouseDown="Seek_Down"
                                    PreviewMouseUp="Seek_Up"/>
                            <TextBlock x:Name="ErrorText" Foreground="#FF8080" FontSize="13"
                                       Visibility="Collapsed" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </vlc:VideoView.Content>
        </vlc:VideoView>
    </Grid>
</Window>
